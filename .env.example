# Gemini API Key for pro features
# Obtain one from https://aistudio.google.com/
GEMINI_API_KEY=your_pro_api_key_here

# Client-side keys for STATIC hosting (Vercel). VITE_-prefixed = bundled into the
# client (publicly visible). You can list SEVERAL keys comma-separated to
# multiply free-tier quota; the app rotates on rate-limit/overload.
VITE_GEMINI_API_KEY=key1,key2

# Optional Groq fallback (free, fast). If set, the app automatically falls back
# to Groq when Gemini is rate-limited/overloaded. Get a key at console.groq.com
VITE_GROQ_API_KEY=your_groq_key_here
