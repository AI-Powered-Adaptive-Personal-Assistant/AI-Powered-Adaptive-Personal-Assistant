# Gemini API Key for pro features
# Obtain one from https://aistudio.google.com/

# Server-side key (used by the Express backend in `npm run dev` / Cloud Run).
# This stays on the server and is NOT exposed to the browser.
GEMINI_API_KEY=your_pro_api_key_here

# Client-side key (Vite, prefixed with VITE_).
# Only needed for STATIC deployments (e.g. Vercel) where the Express backend
# is not running and the app falls back to calling Gemini directly from the browser.
# WARNING: any VITE_-prefixed variable is bundled into the client and is publicly
# visible. Restrict this key (HTTP referrer / API restrictions) before using it.
VITE_GEMINI_API_KEY=your_pro_api_key_here
