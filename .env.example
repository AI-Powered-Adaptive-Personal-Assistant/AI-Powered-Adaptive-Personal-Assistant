# ─────────────────────────────────────────────────────────────────────────────
# SERVER-SIDE keys (no VITE_ prefix) — used by the serverless functions in /api.
#
# These are read by /api/gemini/* at request time and are NEVER sent to the
# browser. Set them in Vercel: Project → Settings → Environment Variables.
#
# Do NOT prefix these with VITE_. Vite inlines every VITE_* variable into the
# production JS bundle, which is public — that is exactly how the previous keys
# ended up extractable from the deployed site.
#
# Each accepts ONE key or several comma/space-separated keys; the server rotates
# across them on 429/503, which multiplies the free-tier quota.
# ─────────────────────────────────────────────────────────────────────────────

# Required. https://aistudio.google.com/
GEMINI_API_KEY=key1,key2

# Optional NVIDIA NIM provider (GLM-5.2, DeepSeek-R1). Keys start with "nvapi-" (build.nvidia.com).
NVIDIA_API_KEY=nvapi-your_nvidia_key_here

# Optional fallback — free and fast. Keys start with "gsk_" (console.groq.com).
GROQ_API_KEY=gsk_your_groq_key_here

# Optional fallback — a DIFFERENT provider from Groq, and paid. Keys start with
# "xai-" (console.x.ai).
XAI_API_KEY=xai-your_grok_key_here


# ─────────────────────────────────────────────────────────────────────────────
# CLIENT-SIDE (VITE_) — these ARE bundled into the public JS by design.
# Only ever put non-secret, publishable values here.
# ─────────────────────────────────────────────────────────────────────────────

# Optional error tracking. A Sentry DSN is a publishable client key, so it is
# safe to expose. sentry.io → project → Client Keys (DSN).
VITE_SENTRY_DSN=
