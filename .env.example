# Gemini API Key for pro features
# Obtain one from https://aistudio.google.com/
GEMINI_API_KEY=your_pro_api_key_here

# Client-side keys for STATIC hosting (Vercel). VITE_-prefixed = bundled into the
# client (publicly visible). You can list SEVERAL keys comma-separated to
# multiply free-tier quota; the app rotates on rate-limit/overload.
VITE_GEMINI_API_KEY=key1,key2

# Optional Groq fallback (free, fast). Keys start with "gsk_" (console.groq.com).
VITE_GROQ_API_KEY=gsk_your_groq_key_here

# Optional xAI / Grok fallback. Keys start with "xai-" (console.x.ai). NOTE: this
# is a DIFFERENT provider from Groq and is paid. Either VITE_GROQ_API_KEY or
# VITE_XAI_API_KEY (or both) enables the fallback.
VITE_XAI_API_KEY=xai_your_grok_key_here

# Optional error tracking. Set to your Sentry project DSN (public client key) to
# capture real user errors. Get it at sentry.io → project → Client Keys (DSN).
VITE_SENTRY_DSN=
