rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId} (matches Auth UID)
    // Fields:
    //   - uid: string (required) - Firebase Auth UID
    //   - email: string (required)
    //   - role: string (required) - 'Student' | 'Professional'
    //   - level: string (required) - 'Basic' | 'Intermediate' | 'Advanced'
    //   - onboardingComplete: bool (required)
    //   - points: number (required)
    //   - iqScore: number (optional)
    //   - lastQuizDate: string (optional) - ISO 8601
    //   - questionHistory: list (optional) - List of {score, date}
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // ── Access tiers (keep in sync with AdminDashboard.tsx) ──────────────────
    // Super Admins sit ABOVE admins: only they can grant/revoke admin rights.
    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.email in [
        "modyhashim2006@gmail.com",
        "mariemsayedr33@gmail.com",
        "pro.mahmoud.h@gmail.com"
      ];
    }

    // Permanent email-based admins (below super admins).
    function isPermanentAdmin() {
      return isAuthenticated() && request.auth.token.email in [
        "marwaneltaweel0@gmail.com",
        "its.alkhateeb@gmail.com",
        "esraahosni8@gmail.com",
        "nermeenatefateffarouk@gmail.com"
      ];
    }

    // Admin = super admin OR permanent admin OR a user whose own /users doc has
    // isAdmin:true (granted via the Admin Dashboard).
    function isAdmin() {
      return isSuperAdmin() || isPermanentAdmin() ||
             (isAuthenticated() &&
              exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true);
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // All permanent members (super admins + permanent admins), lowercase.
    function protectedEmails() {
      return [
        "modyhashim2006@gmail.com",
        "mariemsayedr33@gmail.com",
        "pro.mahmoud.h@gmail.com",
        "marwaneltaweel0@gmail.com",
        "its.alkhateeb@gmail.com",
        "esraahosni8@gmail.com",
        "nermeenatefateffarouk@gmail.com"
      ];
    }

    // A "protected" doc belongs to a permanent member (super admin or permanent
    // admin). Their profiles can never be deleted or tampered with by lower
    // tiers. lower() guards against a stored email with different casing.
    function isProtectedTarget() {
      return resource.data.get('email', '').lower() in protectedEmails();
    }

    // Same protection for a user's SUBCOLLECTIONS (threads, goals, ...): checks
    // the parent /users doc's email. Costs one get() — only on the admin path.
    function isProtectedUser(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)) &&
             get(/databases/$(database)/documents/users/$(userId)).data.get('email', '').lower() in protectedEmails();
    }

    // The isAdmin flag must NOT change unless the writer is an admin. This blocks
    // a normal user from self-promoting by writing isAdmin:true to their own doc.
    function adminFlagUnchanged() {
      return request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false);
    }

    // Identity fields must never change on an update — protects against an admin
    // (or a promoted admin) corrupting/spoofing another user's uid or email,
    // since isValidUser() skips schema checks for admins.
    function identityPreserved() {
      return request.resource.data.uid == resource.data.uid
          && request.resource.data.get('email', '') == resource.data.get('email', '');
    }

    function isValidEmail(email) {
      return email is string && email.size() >= 3 && email.size() <= 256 && email.matches("^[^@]+@[^@]+\\.[^@]+$");
    }

    function isValidUser(data) {
      return isAdmin() || (data.keys().hasAll(["uid", "email", "role", "level", "onboardingComplete", "points"]) &&
             data.uid == request.auth.uid &&
             isValidEmail(data.email) &&
             data.role in ["Student", "Professional"] &&
             data.level in ["Basic", "Intermediate", "Advanced"] &&
             data.points is number &&
             data.onboardingComplete is bool &&
             (!("chatHistory" in data) || data.chatHistory is list) &&
             (!("chatThreads" in data) || data.chatThreads is list) &&
             (!("questionHistory" in data) || data.questionHistory is list) &&
             (!("tasks" in data) || data.tasks is list) &&
             (!("photoURL" in data) || data.photoURL is string));
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      // A new user can create only their own doc and may NOT self-assign admin
      // (only super admins can create an admin doc).
      allow create: if isOwner(userId) && isValidUser(request.resource.data) &&
                    (isSuperAdmin() || request.resource.data.get('isAdmin', false) == false);
      // Either: the user updates their own doc (but can't flip their own admin
      // flag), OR an admin updates anyone's doc — but the admin flag itself can
      // only be changed by a super admin, and NON-super admins can never touch a
      // permanent member's (super admin / permanent admin) profile.
      allow update: if identityPreserved() && (
                      (isOwner(userId) && isValidUser(request.resource.data) && adminFlagUnchanged())
                      || (isAdmin() && (adminFlagUnchanged() || isSuperAdmin())
                          && (!isProtectedTarget() || isOwner(userId) || isSuperAdmin()))
                    );
      // Deletion policy:
      //  - ONLY super admins can delete users. Regular admins can delete no one.
      //  - Permanent members (super admins + permanent admins) can NEVER be
      //    deleted — not even by another super admin.
      allow delete: if isSuperAdmin() && !isProtectedTarget();
      
      // Subcollections (threads, sandbox, goals, courses, attendance, planner,
      // notes, ...): the owner has full access; admins can read everything but
      // may only WRITE to a non-protected user's data — a permanent member's
      // data can only be modified by themselves or a super admin.
      match /{document=**} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isOwner(userId)
                     || (isAdmin() && (isSuperAdmin() || !isProtectedUser(userId)));
      }
    }

    match /system/{docId} {
      allow read: if true; // Connection test path
    }
  }
}
