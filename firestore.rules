rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Document ID: {userId} (matches Auth UID)
    // Fields:
    //   - uid: string (required) - Firebase Auth UID
    //   - email: string (required)
    //   - role: string (required) - 'Student' | 'Professional'
    //   - level: string (required) - 'Basic' | 'Intermediate' | 'Advanced'
    //   - onboardingComplete: bool (required)
    //   - points: number (required)
    //   - iqScore: number (optional)
    //   - lastQuizDate: string (optional) - ISO 8601
    //   - questionHistory: list (optional) - List of {score, date}
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.email_verified == true && request.auth.token.email in [
        "modyhashim2006@gmail.com"
      ];
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidEmail(email) {
      return email is string && email.size() >= 3 && email.size() <= 256 && email.matches("^[^@]+@[^@]+\\.[^@]+$");
    }

    function isValidUser(data) {
      return isAdmin() || (data.keys().hasAll(["uid", "email", "role", "level", "onboardingComplete", "points"]) &&
             data.uid == request.auth.uid &&
             isValidEmail(data.email) &&
             data.role in ["Student", "Professional"] &&
             data.level in ["Basic", "Intermediate", "Advanced"] &&
             data.points is number &&
             data.onboardingComplete is bool &&
             (!("chatHistory" in data) || data.chatHistory is list) &&
             (!("chatThreads" in data) || data.chatThreads is list) &&
             (!("questionHistory" in data) || data.questionHistory is list) &&
             (!("tasks" in data) || data.tasks is list) &&
             (!("photoURL" in data) || data.photoURL is string));
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data) && 
                    request.resource.data.uid == resource.data.uid;
      allow delete: if isAdmin();
      
      match /threads/{threadId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      
      match /sandbox/{sandboxId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    match /system/{docId} {
      allow read: if true; // Connection test path
    }
  }
}
